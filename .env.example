# ============================================
# Firebase Configuration
# ============================================
# IMPORTANT: This is a template file. Do NOT commit real values.
# 
# Instructions for team members:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Replace all placeholder values with your actual Firebase credentials
# 3. Get your Firebase config from: Firebase Console > Project Settings > Your apps
# 4. Never commit your .env file - it's already in .gitignore
#
# Security Best Practices:
# - Never share your .env file via email, Slack, or any unsecured channel
# - Use different Firebase projects for development and production
# - Rotate API keys if they are accidentally exposed
# ============================================

# Firebase Web App Configuration
# Get these values from Firebase Console > Project Settings > Your apps > Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# ============================================
# Optional: Additional Configuration
# ============================================
# Uncomment and configure if needed for your project

# Expo Configuration
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_ENVIRONMENT=development

# Analytics or Other Services (if needed)
# EXPO_PUBLIC_ANALYTICS_ID=your-analytics-id
