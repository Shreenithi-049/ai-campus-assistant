# ============================================
# Environment Variables & Secrets
# ============================================
# CRITICAL: Never commit environment files containing real API keys or secrets
# Team members should create their own .env file locally using .env.example as a template
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging
# Note: .env.example is intentionally NOT ignored - it's a template file with no real secrets

