rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Students collection - users can only access their own data
    match /students/{userId} {
      // Allow read and update only if authenticated and accessing own document
      allow read, update: if request.auth != null 
                          && request.auth.uid == userId;
      
      // Allow create only if authenticated and creating own document
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.email.matches('.*@skcet\\.ac\\.in$');
      
      // Prevent deletion
      allow delete: if false;
    }
    
    // Events collection - read-only for authenticated users
    match /events/{eventId} {
      // All authenticated users can read events
      allow read: if request.auth != null;
      
      // Only admins can write (set to false for now, implement admin role later)
      allow write: if false;
    }
    
    // Academic data collection - read-only for authenticated users
    match /academic/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Faculty collection - read-only for authenticated users
    match /faculty/{facultyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Event Registrations
    match /eventRegistrations/{docId} {
      allow read: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.userId &&
                      request.resource.data.status == 'registered';
      allow update, delete: if false;
    }
    
    // Chat History - users can only access their own chat history
    match /chatHistory/{docId} {
      allow read: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
